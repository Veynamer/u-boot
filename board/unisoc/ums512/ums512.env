preboot=
 sspi 0 00;
 mmc rescan;
 scsi scan;
do_boot=bootflow scan -lb mmc; bootflow scan -lb scsi
bootmenu_0=Boot first available device=run do_boot
bootmenu_1=Reset device=reset
menucmd=bootmenu
bootcmd=run do_boot
fdt_addr_r=0x9df00000
kernel_addr_r=0x80080000
kernel_comp_addr_r=0xc0000000
kernel_comp_size=0x10000000
ramdisk_addr_r=0xa0000000
stdout=vidconsole
stderr=vidconsole
stdin=button-kbd